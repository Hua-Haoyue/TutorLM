# Local integration only. Supply the application image and built frontend first.
TUTORLM_STACK_NAME=tutorlm-local
TUTORLM_EDGE_BIND=127.0.0.1
TUTORLM_EDGE_PORT=47823
TUTORLM_CONTROL_PLANE_PORT=47824
TUTORLM_FRONTEND_DIR=../../instance-app/frontend
TUTORLM_INSTANCE_IMAGE=tutorlm-app:local
TUTORLM_CP_SLOTS=2
TUTORLM_LEASE_TTL_SECONDS=3600
TUTORLM_GC_INTERVAL_SECONDS=30
TUTORLM_PAGE_HEARTBEAT_TIMEOUT_SECONDS=120
TUTORLM_PAGE_CLOSE_GRACE_SECONDS=5
# Project storage expires after four hours without use; compute leases are independent.
TUTORLM_WORKSPACE_IDLE_TTL_SECONDS=inf
TUTORLM_WORKSPACE_PERMANENT=true
TUTORLM_CP_USER=0:0
TUTORLM_CP_ADMIN_TOKEN=
TUTORLM_CP_TOKEN_PEPPER=
TUTORLM_CP_LEASE_COOKIE_SECURE=false

# --- admission (control-plane invitations) ---------------------------------
# true = every new visitor needs a valid invitation code (system or share).
TUTORLM_CP_INVITATION_ONLY=false
# Local image used only to copy a workspace volume when a project is shared.
# Must already exist on the Docker host; the control plane never pulls it.
# Leave empty to fall back to TUTORLM_INSTANCE_IMAGE.
TUTORLM_CP_COPY_HELPER_IMAGE=
# Optional pre-provisioned system codes (JSON array of generated codes).
# Prefer the CLI (`invitations create`) and keep this empty unless you must
# seed codes from a protected local file. Format: TLM-SYS-v1-<43 base64url>.
TUTORLM_CP_SYSTEM_INVITATION_CODES=

# --- application-level (instance container) --------------------------------
# TUTORLM_INVITE_CODE is the *application's own* experience code. It is NOT a
# control-plane system/share code and does not gate admission. Leave empty if
# your application does not use one.
TUTORLM_INVITE_CODE=
TUTORLM_SLOT_MEM_LIMIT=1536m
TUTORLM_SLOT_CPUS=1
TUTORLM_PROVIDER=fake
TUTORLM_MODEL_API_BASE=
TUTORLM_MODEL_API_KEY=
TUTORLM_MODEL_NAME=
TUTORLM_MODEL_MAX_TOKENS=1024
